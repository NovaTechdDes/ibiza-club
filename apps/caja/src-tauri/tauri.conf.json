{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ibiza Caja",
  "version": "../package.json",
  "identifier": "com.novatech.ibizacaja",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ibiza Caja",
        "width": 1366,
        "height": 768
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/imagenes/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyQkI3OEJGMjhBNjM3QUUKUldTdU42WW92M2k3VXFyRlRMZFo0dy9QbVBMSVY1dStUSUZRSkZ3TTkwc01LZlJoUDlLK3kzNE4K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}